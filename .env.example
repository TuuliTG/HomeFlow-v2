# Copy to .env.local and fill in from Supabase → Project Settings → API.
# The anon key is public by design; access control is enforced by Row Level Security.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Optional: public VAPID key for push notifications (ADR 0005). The private key goes only into Supabase
# Edge Function secrets, never here. Leave empty to hide the notifications setting.
VITE_VAPID_PUBLIC_KEY=
