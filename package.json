{
  "name": "homeflow",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "e2e:install": "playwright install --with-deps chromium webkit",
    "knip": "knip",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run knip && npm run test:coverage && npm run build",
    "generate-pwa-assets": "pwa-assets-generator",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:migration": "supabase migration new",
    "db:test": "supabase test db",
    "functions:check": "npx --yes deno@2.9.6 check --config supabase/functions/notify-household/deno.json supabase/functions/notify-household/index.ts && npx --yes deno@2.9.6 check --config supabase/functions/notify-request/deno.json supabase/functions/notify-request/index.ts && npx --yes deno@2.9.6 check --config supabase/functions/send-reminders/deno.json supabase/functions/send-reminders/index.ts && npx --yes deno@2.9.6 check --config supabase/functions/add-child/deno.json supabase/functions/add-child/index.ts && npx --yes deno@2.9.6 check --config supabase/functions/child-sign-in/deno.json supabase/functions/child-sign-in/index.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@fontsource-variable/figtree": "5.3.0",
    "@sentry/react": "11.8.0",
    "@supabase/supabase-js": "2.118.0",
    "@tanstack/react-query": "5.104.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.64.1",
    "@sentry/vite-plugin": "5.4.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vite-pwa/assets-generator": "2.0.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "knip": "6.42.1",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "supabase": "2.121.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.0.5",
    "workbox-core": "7.4.1",
    "workbox-precaching": "7.4.1",
    "workbox-routing": "7.4.1"
  }
}
